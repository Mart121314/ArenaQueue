{
  "name": "arenaq",
  "version": "0.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "watch:build": "ng build --watch",
    "watch:serve": "nodemon --signal SIGTERM dist/Arenaq/server/server.mjs",
    "dev:ssr": "concurrently \"npm:watch:build\" \"npm:watch:serve\"",
    "build:ssr": "ng build",
    "serve:ssr": "node --enable-source-maps dist/Arenaq/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^20.3.8",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.2",
    "@libsql/client": "^0.17.4",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "concurrently": "^9.2.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nodemon": "^3.1.10"
  }
}
